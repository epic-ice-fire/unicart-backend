# ============================================================
# UniCart example environment
# Copy to .env locally. NEVER commit the real .env file.
# ============================================================

# Environment
ENVIRONMENT=development
AUTO_CREATE_TABLES=true

# Local development database. Production must use PostgreSQL.
DATABASE_URL=sqlite+aiosqlite:///./unicart.db
DB_CONNECT_TIMEOUT_SECONDS=10

# Authentication / sessions
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=replace-with-a-unique-random-secret-at-least-32-characters
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_ISSUER=unicart-api
JWT_AUDIENCE=unicart-app
MAX_ACTIVE_SESSIONS_PER_USER=5
SESSION_RETENTION_DAYS=30

# Request / audit limits
MAX_REQUEST_BODY_BYTES=1048576
MAX_WEBHOOK_BODY_BYTES=65536
MAX_AUDIT_DETAILS_BYTES=4096
PAYMENT_CHECKOUT_TTL_MINUTES=30

# Business values
ENTRY_FEE_NGN=2000
TARGET_ITEM_AMOUNT_NGN=50000

# PAU verification
ALLOWED_EMAIL_DOMAINS=pau.edu.ng
PAU_CODE_EXPIRES_MINUTES=10
DEBUG_RETURN_PAU_CODE=false

# Gmail sender
GMAIL_USER=
GMAIL_APP_PASSWORD=
ADMIN_EMAIL=unicartbytekena@gmail.com

# Flutterwave
# Use TEST keys locally. Production must use LIVE keys.
FLW_PUBLIC_KEY=
FLW_SECRET_KEY=
FLW_ENCRYPTION_KEY=
# Generate a separate random webhook secret and configure the exact same value
# in the Flutterwave dashboard. Do not reuse FLW_SECRET_KEY.
FLW_SECRET_HASH=
FLW_BASE_URL=https://api.flutterwave.com/v3
FLW_CALLBACK_URL=http://127.0.0.1:8000/payments/callback

# Browser/API trust boundaries
BACKEND_CORS_ORIGINS=http://localhost:3000,http://localhost:8000,http://127.0.0.1:3000,http://127.0.0.1:8000
ALLOWED_HOSTS=localhost,127.0.0.1,testserver

# Production example notes (do not paste literally):
# ENVIRONMENT=production
# AUTO_CREATE_TABLES=false
# DATABASE_URL=postgresql+asyncpg://...
# DEBUG_RETURN_PAU_CODE=false
# FLW_CALLBACK_URL=https://api.your-domain.com/payments/callback
# BACKEND_CORS_ORIGINS=https://your-frontend-domain.com
# ALLOWED_HOSTS=api.your-domain.com,your-render-service.onrender.com
